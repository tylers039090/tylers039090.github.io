# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…) or the legacy anon key — either works
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only addresses listed here get a sign-in email (comma-separated). Leave empty to allow any.
ALLOWED_EMAILS=

# Optional: fixed site URL for magic links (defaults to the request host)
NEXT_PUBLIC_SITE_URL=

# ── Server-only secrets: never prefix with NEXT_PUBLIC_ ──
# Used by scripts/import-export.ts now, and by the score poller from milestone 3
SUPABASE_SERVICE_ROLE_KEY=
# Address you signed in with — the importer assigns bets to this user
IMPORT_USER_EMAIL=

# Milestone 4 (screenshot reading)
# ANTHROPIC_API_KEY=
# v1.1 (push alerts)
# VAPID_PRIVATE_KEY=
